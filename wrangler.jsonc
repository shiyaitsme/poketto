{
  // Timeline writes check the Worker secret EDIT_PASS. Set it outside the repo:
  //   wrangler secret put EDIT_PASS
  // Do not put the passphrase in this file. If the secret is missing, PUT stays closed.
  "name": "poketto",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "TIMELINE_KV" }
  ]
}
